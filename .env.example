# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://tidehotels.de"

# Server-side Resend Email Delivery (NEVER prefix with VITE_ - server only)
# Configure these as secure server-side environment variables in Hostinger
RESEND_API_KEY=
# Verified Resend sender identity (format: "Display Name <email@verified-domain>")
RESEND_FROM_EMAIL="Hotel Notifications <notifications@mail.tidehotels.de>"
# Optional Resend Webhook signing secret (whsec_...) for delivery lifecycle tracking
RESEND_WEBHOOK_SECRET=
# Optional Platform SuperAdmin alert email(s) (comma-separated fallback if system/settings.supportEmail is unset)
PLATFORM_ADMIN_EMAIL=
# Email Customization Module feature flag (defaults to true; set to false for instant fallback to default templates)
EMAIL_CUSTOMIZATION_ENABLED=true
# Shared secret for Hostinger Cron calling POST /api/email-customization/cron/run (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Email Image Library Storage Provider (server-only, NEVER prefix with VITE_)
# Allowed values: "local" (default, persistent directory outside build folder) or "cloudinary"
IMAGE_STORAGE_PROVIDER=local
# Persistent directory outside build/deploy folder when IMAGE_STORAGE_PROVIDER=local (e.g., /home/youruser/pms-uploads)
IMAGE_UPLOAD_DIR=
# Server-side signed Cloudinary upload credentials (required only when IMAGE_STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Fallback SMTP Settings for Email Dispatches
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=

