rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    //////////////////////////////
    // AUTH HELPERS
    //////////////////////////////

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function userExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.uid == "ighGTXpOuehSqh1pTwSXLPz0Akk1" ||
        (request.auth.token.email != null && request.auth.token.email.lower() == "smartwavetechcompany@gmail.com") ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "superAdmin")
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "hotelAdmin" ||
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "manager") ||
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles != null && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['manager', 'corporate']))))
      );
    }

    function isHotelAdmin() {
      let data = getUserData();
      return data != null && (data.role == "hotelAdmin" || isSuperAdmin());
    }

    function hasStaffManagementPermission() {
      let data = getUserData();
      return data != null && (
        isSuperAdmin() ||
        data.role == "hotelAdmin" ||
        (data.permissions != null && data.permissions.hasAny(['manage_staff', 'manage_roles'])) ||
        (data.roles != null && data.roles.hasAny(['manager', 'admin']))
      );
    }

    function isStaff() {
      let data = getUserData();
      return data != null && data.role == "staff";
    }

    function getHotelId() {
      let data = getUserData();
      return data != null ? data.hotelId : null;
    }

    function sameHotel(hotelId) {
      return getHotelId() == hotelId;
    }

    function isStaffOf(hotelId) {
      let data = getUserData();
      return data != null && data.hotelId == hotelId && data.role != "guest" && data.role != "corporate";
    }

    function subscriptionActive(hotelId) {
      let path = /databases/$(database)/documents/hotels/$(hotelId);
      return exists(path) && (
        get(path).data.subscriptionStatus == "active" ||
        get(path).data.subscriptionStatus == null
      );
    }

    //////////////////////////////
    // TRACKING CODES
    //////////////////////////////

    match /trackingCodes/{codeId} {
      // SuperAdmin has full control to create, update, delete
      allow read, write: if isSuperAdmin();

      // Prospective hotel owners & renewing hotels can validate and query tracking codes
      allow read: if true;

      // Allow usage update during hotel registration or subscription renewal
      allow update: if isSuperAdmin() || (
        isAuthenticated() && (
          request.resource.data.status in ['used', 'active']
        )
      );

      allow create, delete: if isSuperAdmin();
    }

    //////////////////////////////
    // USERS
    //////////////////////////////

    match /users/{userId} {
      // Allow reading user document (needed for login, activation, and hotel membership verification)
      allow read: if true;

      allow create: if (isAuthenticated() && (
                      (request.auth.uid == userId && request.resource.data.role != "superAdmin") ||
                      (isAdmin() && request.resource.data.hotelId == getHotelId() && hasStaffManagementPermission() && request.resource.data.role != "superAdmin") ||
                      isSuperAdmin()
                    ));

      allow update: if (
                      // 1. Allow account activation status updates (transitioning from pending_activation to active)
                      (
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'status', 'isVerified', 'emailVerified', 'temporaryPassword', 
                          'initialPassword', 'forcePasswordChange', 'passwordChangedAt', 
                          'passwordChangedBy', 'updatedAt', 'activationToken', 'activationLink',
                          'initialTempPass'
                        ]) &&
                        request.resource.data.status in ['active', 'pending_activation'] &&
                        request.resource.data.role == resource.data.role &&
                        request.resource.data.hotelId == resource.data.hotelId
                      ) ||
                      (isAuthenticated() && (
                        (request.auth.uid == userId) ||
                        (isAdmin() && resource != null && resource.data.hotelId == getHotelId() &&
                         hasStaffManagementPermission() &&
                         request.resource.data.role != "superAdmin") ||
                        (hasStaffManagementPermission() && request.resource.data.role != "superAdmin") ||
                        isSuperAdmin()
                      ))
                    );

      allow delete: if isAuthenticated() && (
                      isSuperAdmin() ||
                      ((isHotelAdmin() || hasStaffManagementPermission() || isAdmin()) && resource != null && resource.data.hotelId == getHotelId() && request.auth.uid != userId)
                    );
    }

    //////////////////////////////
    // HOTELS (Multi-Tenant Root)
    //////////////////////////////

    match /hotels/{hotelId} {
      // Allow creation during registration
      allow create: if isAuthenticated();
      
      // Tenant Isolation: SuperAdmin, users from this hotel, or the admin UID listed on the hotel
      allow read: if isSuperAdmin() || sameHotel(hotelId) || 
                     (resource != null && resource.data.adminUIDs != null && resource.data.adminUIDs.hasAny([request.auth.uid]));
      allow update: if isSuperAdmin() || 
                       (sameHotel(hotelId) && (isHotelAdmin() || isAdmin())) ||
                       (resource != null && resource.data.adminUIDs != null && resource.data.adminUIDs.hasAny([request.auth.uid]));
      allow delete: if isSuperAdmin();

      // Activity / Audit Logs under hotel
      match /activityLogs/{logId} {
        allow read: if isSuperAdmin() || isStaffOf(hotelId) || sameHotel(hotelId);
        allow create: if true;
        allow update, delete: if isSuperAdmin();
      }

      match /auditLogs/{logId} {
        allow read: if isSuperAdmin() || isStaffOf(hotelId) || sameHotel(hotelId);
        allow create: if true;
        allow update, delete: if isSuperAdmin();
      }

      match /AuditLogs/{logId} {
        allow read: if isSuperAdmin() || isStaffOf(hotelId) || sameHotel(hotelId);
        allow create: if true;
        allow update, delete: if isSuperAdmin();
      }

      // Corporate Accounts
      match /corporate_accounts/{accountId} {
        allow read: if isSuperAdmin() || isStaffOf(hotelId) || sameHotel(hotelId);
        allow create, update: if isSuperAdmin() || (isAdmin() && sameHotel(hotelId));
        allow delete: if isSuperAdmin() || (sameHotel(hotelId) && isHotelAdmin());

        match /rates/{rateId} {
          allow read: if isSuperAdmin() || isStaffOf(hotelId) || sameHotel(hotelId);
          allow create, update: if isSuperAdmin() || (isAdmin() && sameHotel(hotelId));
          allow delete: if isSuperAdmin() || (sameHotel(hotelId) && isHotelAdmin());
        }
      }

      // Custom Roles & Permissions (RBAC)
      match /customRoles/{roleId} {
        allow read: if isSuperAdmin() || isStaffOf(hotelId) || sameHotel(hotelId);
        allow create, update: if isSuperAdmin() || ((isAdmin() || hasStaffManagementPermission()) && sameHotel(hotelId));
        allow delete: if isSuperAdmin() || (sameHotel(hotelId) && (isHotelAdmin() || hasStaffManagementPermission()));
      }

      // Active Sessions (Session Control Center)
      match /sessions/{sessionId} {
        allow read: if isSuperAdmin() || isStaffOf(hotelId) || sameHotel(hotelId);
        allow create, update: if isSuperAdmin() || isStaffOf(hotelId) || sameHotel(hotelId);
        allow delete: if isSuperAdmin() || (sameHotel(hotelId) && (isHotelAdmin() || hasStaffManagementPermission()));
      }

      // Email notifications / outbox
      match /emailNotifications/{docId} {
        allow read: if isSuperAdmin() || isStaffOf(hotelId) || sameHotel(hotelId);
        allow create: if true;
        allow update, delete: if isSuperAdmin() || (sameHotel(hotelId) && (isHotelAdmin() || hasStaffManagementPermission()));
      }

      // User Settings & Preferences
      match /user_settings/{userId} {
        allow read, write: if isSuperAdmin() || (sameHotel(hotelId) && (request.auth.uid == userId || isHotelAdmin() || hasStaffManagementPermission()));
        allow delete: if isSuperAdmin() || (sameHotel(hotelId) && (request.auth.uid == userId || isHotelAdmin() || hasStaffManagementPermission()));
      }

      // Ledger entries are immutable and append-only audit logs.
      match /ledger/{entryId} {
        allow read: if isSuperAdmin() || isStaffOf(hotelId) || sameHotel(hotelId);
        allow create: if isSuperAdmin() || (
          (isStaffOf(hotelId) || sameHotel(hotelId)) &&
          request.resource.data.amount != null &&
          request.resource.data.amount >= 0 &&
          request.resource.data.type in ['debit', 'credit'] &&
          request.resource.data.category is string &&
          request.resource.data.timestamp != null
        );
        allow update: if isSuperAdmin();
        allow delete: if isSuperAdmin();
      }

      // Staff account activation and password reset tokens for this property
      match /passwordResetTokens/{tokenId} {
        allow read: if true;
        allow create: if isSuperAdmin() || isHotelAdmin() || hasStaffManagementPermission() || isAuthenticated();
        allow update: if isSuperAdmin() || isHotelAdmin() || hasStaffManagementPermission() ||
                         (request.resource.data.isUsed == true && resource.data.isUsed == false) ||
                         (request.resource.data.status in ['used', 'revoked']);
        allow delete: if isSuperAdmin() || (sameHotel(hotelId) && (isHotelAdmin() || hasStaffManagementPermission()));
      }

      // Recursive subcollections (Rooms, Reservations, Housekeeping, Staff, etc.)
      match /{allSubcollections=**} {
        allow read: if isSuperAdmin() || isStaffOf(hotelId) || sameHotel(hotelId) ||
                       (resource != null && resource.data.hotelId == hotelId);
        allow create, update: if isSuperAdmin() || isStaffOf(hotelId) || sameHotel(hotelId) ||
                                 (exists(/databases/$(database)/documents/hotels/$(hotelId)) &&
                                  get(/databases/$(database)/documents/hotels/$(hotelId)).data.adminUIDs.hasAny([request.auth.uid]));
        allow delete: if isSuperAdmin() || (sameHotel(hotelId) && isHotelAdmin());
      }
    }

    //////////////////////////////
    // SYSTEM SETTINGS & LOGS
    //////////////////////////////

    match /system/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /systemLogs/{allPaths=**} {
      allow read: if isSuperAdmin();
      allow create: if true;
    }

    match /activityLogs/{logId} {
      allow read, list: if isSuperAdmin() || isAuthenticated();
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    // Collection Group rule for activityLogs
    match /{path=**}/activityLogs/{logId} {
      allow read, list: if isSuperAdmin() || isAuthenticated();
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    match /auditLogs/{logId} {
      allow read, list: if isSuperAdmin() || isAuthenticated();
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    match /{path=**}/auditLogs/{logId} {
      allow read, list: if isSuperAdmin() || isAuthenticated();
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    match /{path=**}/AuditLogs/{logId} {
      allow read, list: if isSuperAdmin() || isAuthenticated();
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    match /GlobalAuditLog/{logId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && isAdmin() && resource.data.hotelId == getHotelId());
      allow create: if true;
    }

    match /registration/{docId} {
      allow create, read: if true;
      allow write: if isSuperAdmin();
    }

    match /trackingCodeRequests/{requestId} {
      // SuperAdmin has full management access to review, approve, and reject
      allow read, write: if isSuperAdmin();
      // Prospective hotel owners can submit code requests before registering, and check request status
      allow read, create: if true;
      allow update, delete: if isSuperAdmin();
    }

    match /passwordResetTokens/{tokenId} {
      allow read, write: if true;
    }

    match /activationTokens/{tokenId} {
      allow read, write: if true;
    }
  }
}
