rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    //////////////////////////////
    // AUTH HELPERS
    //////////////////////////////

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function userExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.uid == "ighGTXpOuehSqh1pTwSXLPz0Akk1" ||
        (request.auth.token.email != null && request.auth.token.email.lower() == "smartwavetechcompany@gmail.com") ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "superAdmin")
      );
    }

    function isAdmin() {
      let data = getUserData();
      return isAuthenticated() && (
        isSuperAdmin() ||
        (data != null && (
          data.role == "hotelAdmin" ||
          data.role == "admin" ||
          data.role == "hotel_admin" ||
          data.role == "manager" ||
          (data.permissions != null && data.permissions is list && 
           data.permissions.hasAny(['edit_settings', 'edit_hotel_settings', 'manage_settings', 'manage_staff', 'manage_roles', 'create_users', 'edit_users', 'delete_users', 'assign_roles', 'manage_users_admin'])) ||
          (data.roles != null && data.roles is list && 
           data.roles.hasAny(['manager', 'corporate', 'admin', 'hotelAdmin']))
        ))
      );
    }

    function isHotelAdmin() {
      let data = getUserData();
      return data != null && (
        data.role == "hotelAdmin" || 
        data.role == "admin" || 
        data.role == "hotel_admin" ||
        (data.roles != null && data.roles is list && data.roles.hasAny(['hotelAdmin', 'admin', 'manager'])) ||
        isSuperAdmin()
      );
    }

    function hasStaffManagementPermission() {
      let data = getUserData();
      return data != null && (
        isSuperAdmin() ||
        data.role == "hotelAdmin" ||
        data.role == "admin" ||
        data.role == "hotel_admin" ||
        (data.permissions != null && data.permissions is list && data.permissions.hasAny(['manage_staff', 'manage_roles', 'create_users', 'edit_users', 'delete_users', 'assign_roles', 'manage_users_admin'])) ||
        (data.roles != null && data.roles is list && data.roles.hasAny(['manager', 'admin', 'hotelAdmin']))
      );
    }

    function isStaff() {
      let data = getUserData();
      return data != null && data.role == "staff";
    }

    function getHotelId() {
      let data = getUserData();
      return data != null ? (data.hotelId != null ? data.hotelId : data.hotel_id) : null;
    }

    function sameHotel(hotelId) {
      let data = getUserData();
      return (data != null && (data.hotelId == hotelId || data.hotel_id == hotelId || (data.hotelIds != null && data.hotelIds is list && data.hotelIds.hasAny([hotelId])))) ||
             (isAuthenticated() && exists(/databases/$(database)/documents/hotels/$(hotelId)/staff/$(request.auth.uid)));
    }

    function isStaffOf(hotelId) {
      let data = getUserData();
      return (data != null && (data.hotelId == hotelId || data.hotel_id == hotelId || (data.hotelIds != null && data.hotelIds is list && data.hotelIds.hasAny([hotelId]))) && data.role != "guest" && data.role != "corporate") ||
             (isAuthenticated() && exists(/databases/$(database)/documents/hotels/$(hotelId)/staff/$(request.auth.uid)));
    }

    function subscriptionActive(hotelId) {
      let path = /databases/$(database)/documents/hotels/$(hotelId);
      return exists(path) && (
        get(path).data.subscriptionStatus == "active" ||
        get(path).data.subscriptionStatus == null
      );
    }

    function customRoleHasPermission(hotelId, customRoleId, perm) {
      return customRoleId is string &&
        customRoleId != '' &&
        exists(/databases/$(database)/documents/hotels/$(hotelId)/customRoles/$(customRoleId)) &&
        get(/databases/$(database)/documents/hotels/$(hotelId)/customRoles/$(customRoleId)).data.get('status', 'active') != 'disabled' &&
        get(/databases/$(database)/documents/hotels/$(hotelId)/customRoles/$(customRoleId)).data.get('status', 'active') != 'archived' &&
        get(/databases/$(database)/documents/hotels/$(hotelId)/customRoles/$(customRoleId)).data.get('permissions', []) is list &&
        get(/databases/$(database)/documents/hotels/$(hotelId)/customRoles/$(customRoleId)).data.get('permissions', []).hasAny([perm, 'all']);
    }

    function canBlockRestaurantPosting(hotelId) {
      let data = getUserData();
      let roleId = data != null ? data.get('customRoleId', '') : '';
      let hasCustomRoleDoc = roleId is string && roleId != '' && exists(/databases/$(database)/documents/hotels/$(hotelId)/customRoles/$(roleId));
      return isAuthenticated() && (
        isSuperAdmin() ||
        (sameHotel(hotelId) && data != null && data.get('status', 'active') != "suspended" && data.get('status', 'active') != "inactive" && (
          data.role == "hotelAdmin" ||
          data.role == "admin" ||
          data.role == "hotel_admin" ||
          (hasCustomRoleDoc
            ? customRoleHasPermission(hotelId, roleId, 'block_restaurant_posting')
            : (data.get('permissions', []) is list && data.get('permissions', []).hasAny(['block_restaurant_posting', 'all'])))
        ))
      );
    }

    function canDepositGuestAccount(hotelId) {
      let data = getUserData();
      let roleId = data != null ? data.get('customRoleId', '') : '';
      let hasCustomRoleDoc = roleId is string && roleId != '' && exists(/databases/$(database)/documents/hotels/$(hotelId)/customRoles/$(roleId));
      return isAuthenticated() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/hotels/$(hotelId)) &&
         get(/databases/$(database)/documents/hotels/$(hotelId)).data.adminUIDs != null &&
         get(/databases/$(database)/documents/hotels/$(hotelId)).data.adminUIDs is list &&
         get(/databases/$(database)/documents/hotels/$(hotelId)).data.adminUIDs.hasAny([request.auth.uid])) ||
        (sameHotel(hotelId) && data != null && data.get('status', 'active') != "suspended" && data.get('status', 'active') != "inactive" && (
          data.role == "hotelAdmin" ||
          data.role == "admin" ||
          data.role == "hotel_admin" ||
          (hasCustomRoleDoc
            ? customRoleHasPermission(hotelId, roleId, 'deposit_guest_account')
            : (data.get('permissions', []) is list && data.get('permissions', []).hasAny(['deposit_guest_account', 'all'])))
        ))
      );
    }

    function canManageEmailTemplates(hotelId) {
      let data = getUserData();
      let roleId = data != null ? data.get('customRoleId', '') : '';
      let hasCustomRoleDoc = roleId is string && roleId != '' && exists(/databases/$(database)/documents/hotels/$(hotelId)/customRoles/$(roleId));
      return isAuthenticated() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/hotels/$(hotelId)) &&
         get(/databases/$(database)/documents/hotels/$(hotelId)).data.adminUIDs != null &&
         get(/databases/$(database)/documents/hotels/$(hotelId)).data.adminUIDs is list &&
         get(/databases/$(database)/documents/hotels/$(hotelId)).data.adminUIDs.hasAny([request.auth.uid])) ||
        (sameHotel(hotelId) && data != null && data.get('status', 'active') != "suspended" && data.get('status', 'active') != "inactive" && (
          data.role == "hotelAdmin" ||
          data.role == "admin" ||
          data.role == "hotel_admin" ||
          data.get('staffRole', '') == "admin" ||
          (hasCustomRoleDoc
            ? customRoleHasPermission(hotelId, roleId, 'manage_email_templates')
            : (data.get('permissions', []) is list && data.get('permissions', []).hasAny(['manage_email_templates', 'all'])))
        ))
      );
    }

    function canViewEmailTemplates(hotelId) {
      let data = getUserData();
      let roleId = data != null ? data.get('customRoleId', '') : '';
      let hasCustomRoleDoc = roleId is string && roleId != '' && exists(/databases/$(database)/documents/hotels/$(hotelId)/customRoles/$(roleId));
      return canManageEmailTemplates(hotelId) || (
        isAuthenticated() &&
        sameHotel(hotelId) &&
        data != null &&
        data.get('status', 'active') != "suspended" &&
        data.get('status', 'active') != "inactive" &&
        (hasCustomRoleDoc
          ? customRoleHasPermission(hotelId, roleId, 'view_email_templates')
          : (data.get('permissions', []) is list && data.get('permissions', []).hasAny(['view_email_templates', 'manage_email_templates', 'all'])))
      );
    }

    function canManageLoyalty(hotelId) {
      let data = getUserData();
      let roleId = data != null ? data.get('customRoleId', '') : '';
      let hasCustomRoleDoc = roleId is string && roleId != '' && exists(/databases/$(database)/documents/hotels/$(hotelId)/customRoles/$(roleId));
      return isAuthenticated() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/hotels/$(hotelId)) &&
         get(/databases/$(database)/documents/hotels/$(hotelId)).data.adminUIDs != null &&
         get(/databases/$(database)/documents/hotels/$(hotelId)).data.adminUIDs is list &&
         get(/databases/$(database)/documents/hotels/$(hotelId)).data.adminUIDs.hasAny([request.auth.uid])) ||
        (sameHotel(hotelId) && data != null &&
         data.role != "guest" && data.role != "corporate" &&
         data.get('status', 'active') != "suspended" &&
         data.get('status', 'active') != "inactive" && (
          data.role == "hotelAdmin" ||
          data.role == "admin" ||
          data.role == "hotel_admin" ||
          (hasCustomRoleDoc
            ? customRoleHasPermission(hotelId, roleId, 'manage_loyalty')
            : (data.get('permissions', []) is list && data.get('permissions', []).hasAny(['manage_loyalty', 'all'])))
        ))
      );
    }

    function isStrictHotelAdminOf(hotelId) {
      let data = getUserData();
      return isAuthenticated() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/hotels/$(hotelId)) &&
         get(/databases/$(database)/documents/hotels/$(hotelId)).data.adminUIDs != null &&
         get(/databases/$(database)/documents/hotels/$(hotelId)).data.adminUIDs is list &&
         get(/databases/$(database)/documents/hotels/$(hotelId)).data.adminUIDs.hasAny([request.auth.uid])) ||
        (sameHotel(hotelId) && data != null &&
         data.role != "guest" && data.role != "corporate" &&
         data.get('status', 'active') != "suspended" &&
         data.get('status', 'active') != "inactive" &&
         (data.role == "hotelAdmin" || data.role == "admin" || data.role == "hotel_admin"))
      );
    }

    function canViewLoyalty(hotelId) {
      let data = getUserData();
      let roleId = data != null ? data.get('customRoleId', '') : '';
      let hasCustomRoleDoc = roleId is string && roleId != '' && exists(/databases/$(database)/documents/hotels/$(hotelId)/customRoles/$(roleId));
      return canManageLoyalty(hotelId) || (
        isAuthenticated() &&
        sameHotel(hotelId) &&
        data != null &&
        data.role != "guest" &&
        data.role != "corporate" &&
        data.get('status', 'active') != "suspended" &&
        data.get('status', 'active') != "inactive" &&
        (hasCustomRoleDoc
          ? (customRoleHasPermission(hotelId, roleId, 'view_loyalty') || customRoleHasPermission(hotelId, roleId, 'view_guests'))
          : (data.get('permissions', []) is list && data.get('permissions', []).hasAny(['view_loyalty', 'manage_loyalty', 'view_guests', 'all'])))
      );
    }

    function isValidLoyaltyId(idVal) {
      return idVal is string && idVal.size() >= 1 && idVal.size() <= 160 && idVal.matches('^[a-zA-Z0-9_\\-:.]+$');
    }

    function isValidLoyaltyAccount(data, hotelId, guestId) {
      return data.hotelId == hotelId &&
        data.guestId == guestId &&
        data.guestName is string && data.guestName.size() >= 1 && data.guestName.size() <= 200 &&
        data.availablePoints is number && data.availablePoints >= 0 &&
        data.lifetimePointsEarned is number && data.lifetimePointsEarned >= 0 &&
        data.totalPointsRedeemed is number && data.totalPointsRedeemed >= 0 &&
        data.totalPointsExpired is number && data.totalPointsExpired >= 0 &&
        data.membershipLevelId is string && data.membershipLevelId.size() >= 1 && data.membershipLevelId.size() <= 100 &&
        data.membershipLevelName is string && data.membershipLevelName.size() >= 1 && data.membershipLevelName.size() <= 100 &&
        data.isActive is bool;
    }

    function isValidLoyaltyTransaction(data, hotelId) {
      return data.hotelId == hotelId &&
        isValidLoyaltyId(data.guestId) &&
        data.guestName is string && data.guestName.size() >= 1 && data.guestName.size() <= 200 &&
        data.transactionType in ['account_activation', 'earn_auto', 'manual_award', 'manual_deduct', 'redemption', 'expiry', 'reversal', 'tier_change'] &&
        data.points is number && data.points >= 0 &&
        data.pointsDelta is number &&
        data.previousBalance is number && data.previousBalance >= 0 &&
        data.updatedBalance is number && data.updatedBalance >= 0 &&
        data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 500 &&
        data.adminId is string && data.adminId.size() >= 1 && data.adminId.size() <= 160 &&
        isValidLoyaltyId(data.idempotencyKey) &&
        data.timestamp is string;
    }

    function roomHasPostingBlocked(hotelId, roomId) {
      return roomId is string &&
        roomId != '' &&
        exists(/databases/$(database)/documents/hotels/$(hotelId)/rooms/$(roomId)) &&
        get(/databases/$(database)/documents/hotels/$(hotelId)/rooms/$(roomId)).data.get('restaurantPostingBlocked', false) == true;
    }

    function isRoomRestaurantPostingAllowedForReservation(hotelId, reservationId) {
      return !(reservationId is string) ||
        reservationId == '' ||
        !exists(/databases/$(database)/documents/hotels/$(hotelId)/reservations/$(reservationId)) ||
        !roomHasPostingBlocked(
          hotelId,
          get(/databases/$(database)/documents/hotels/$(hotelId)/reservations/$(reservationId)).data.get('roomId', '')
        );
    }

    //////////////////////////////
    // TRACKING CODES
    //////////////////////////////

    match /trackingCodes/{codeId} {
      // SuperAdmin has full control to create, update, delete
      allow read, write: if isSuperAdmin();

      // Prospective hotel owners & renewing hotels can validate and query tracking codes
      allow read: if true;

      // Allow usage update during hotel registration or subscription renewal
      allow update: if isSuperAdmin() || (
        isAuthenticated() && (
          request.resource.data.status in ['used', 'active']
        )
      );

      allow create, delete: if isSuperAdmin();
    }

    //////////////////////////////
    // USERS
    //////////////////////////////

    match /users/{userId} {
      // Allow reading user document (needed for login, activation, and hotel membership verification)
      allow read: if true;

      allow create: if (isAuthenticated() && (
                      (request.auth.uid == userId && request.resource.data.role != "superAdmin") ||
                      ((isAdmin() || hasStaffManagementPermission()) && (request.resource.data.hotelId == getHotelId() || request.resource.data.hotel_id == getHotelId()) && hasStaffManagementPermission() && request.resource.data.role != "superAdmin") ||
                      isSuperAdmin()
                    ));

      allow update: if (
                      // 1. Allow account activation status updates (transitioning from pending_activation to active)
                      (
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'status', 'isVerified', 'emailVerified', 'temporaryPassword', 
                          'initialPassword', 'forcePasswordChange', 'passwordChangedAt', 
                          'passwordChangedBy', 'updatedAt', 'activationToken', 'activationLink',
                          'initialTempPass', 'systemAuthSecret', 'passwordResetTokenId',
                          'passwordResetExpiresAt', 'firebase_uid'
                        ]) &&
                        request.resource.data.status in ['active', 'pending_activation'] &&
                        request.resource.data.role == resource.data.role &&
                        (request.resource.data.hotelId == resource.data.hotelId || request.resource.data.hotel_id == resource.data.hotel_id)
                      ) ||
                      (isAuthenticated() && (
                        (request.auth.uid == userId && (
                          isHotelAdmin() || isSuperAdmin() || (
                            request.resource.data.role == resource.data.role &&
                            (resource.data.permissions == null || request.resource.data.permissions == resource.data.permissions) &&
                            (resource.data.customRoleId == null || request.resource.data.customRoleId == resource.data.customRoleId)
                          )
                        )) ||
                        (isAdmin() && resource != null && (resource.data.hotelId == getHotelId() || resource.data.hotel_id == getHotelId()) &&
                         hasStaffManagementPermission() &&
                         request.resource.data.role != "superAdmin") ||
                        (hasStaffManagementPermission() && resource != null && (resource.data.hotelId == getHotelId() || resource.data.hotel_id == getHotelId()) && request.resource.data.role != "superAdmin") ||
                        isSuperAdmin()
                      ))
                    );

      allow delete: if isAuthenticated() && (
                      isSuperAdmin() ||
                      ((isHotelAdmin() || hasStaffManagementPermission() || isAdmin()) && resource != null && (resource.data.hotelId == getHotelId() || resource.data.hotel_id == getHotelId()) && request.auth.uid != userId) ||
                      (resource != null && resource.data.email != null && request.auth.token.email != null && resource.data.email.lower() == request.auth.token.email.lower() && resource.data.role != "superAdmin" && request.auth.uid != userId)
                    );
    }

    //////////////////////////////
    // HOTELS (Multi-Tenant Root)
    //////////////////////////////

    match /hotels/{hotelId} {
      // Allow creation during registration
      allow create: if isAuthenticated();
      
      // Tenant Isolation: SuperAdmin, users from this hotel, or the admin UID listed on the hotel
      allow read: if true;
      allow update: if isSuperAdmin() || 
                       (sameHotel(hotelId) && (isHotelAdmin() || isAdmin())) ||
                       (isStaffOf(hotelId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastAuditDate', 'updatedAt'])) ||
                       (resource != null && resource.data.adminUIDs != null && resource.data.adminUIDs.hasAny([request.auth.uid]));
      allow delete: if isSuperAdmin();

      // Activity / Audit Logs under hotel
      match /activityLogs/{logId} {
        allow read: if isSuperAdmin() || isStaffOf(hotelId) || sameHotel(hotelId);
        allow create: if true;
        allow update, delete: if isSuperAdmin();
      }

      match /auditLogs/{logId} {
        allow read: if isSuperAdmin() || isStaffOf(hotelId) || sameHotel(hotelId);
        allow create: if true;
        allow update, delete: if isSuperAdmin();
      }

      match /AuditLogs/{logId} {
        allow read: if isSuperAdmin() || isStaffOf(hotelId) || sameHotel(hotelId);
        allow create: if true;
        allow update, delete: if isSuperAdmin();
      }

      // Corporate Accounts
      match /corporate_accounts/{accountId} {
        allow read: if isSuperAdmin() || isStaffOf(hotelId) || sameHotel(hotelId);
        allow create, update: if isSuperAdmin() || (isAdmin() && sameHotel(hotelId));
        allow delete: if isSuperAdmin() || (sameHotel(hotelId) && isHotelAdmin());

        match /rates/{rateId} {
          allow read: if isSuperAdmin() || isStaffOf(hotelId) || sameHotel(hotelId);
          allow create, update: if isSuperAdmin() || (isAdmin() && sameHotel(hotelId));
          allow delete: if isSuperAdmin() || (sameHotel(hotelId) && isHotelAdmin());
        }
      }

      // Custom Roles & Permissions (RBAC)
      match /customRoles/{roleId} {
        allow read: if isSuperAdmin() || isStaffOf(hotelId) || sameHotel(hotelId);
        allow create, update: if isSuperAdmin() || ((isAdmin() || hasStaffManagementPermission()) && sameHotel(hotelId));
        allow delete: if isSuperAdmin() || (sameHotel(hotelId) && (isHotelAdmin() || hasStaffManagementPermission()));
      }

      // Active Sessions (Session Control Center)
      match /sessions/{sessionId} {
        allow read: if isSuperAdmin() || isStaffOf(hotelId) || sameHotel(hotelId);
        allow create, update: if isSuperAdmin() || isStaffOf(hotelId) || sameHotel(hotelId);
        allow delete: if isSuperAdmin() || (sameHotel(hotelId) && (isHotelAdmin() || hasStaffManagementPermission()));
      }

      // Email notifications / outbox
      match /emailNotifications/{docId} {
        allow read: if isSuperAdmin() || isStaffOf(hotelId) || sameHotel(hotelId);
        allow create: if true;
        allow update, delete: if isSuperAdmin() || (sameHotel(hotelId) && (isHotelAdmin() || hasStaffManagementPermission()));
      }

      // Email Customization: Templates (Hotel Admin / Admin / RBAC-assigned own hotel)
      match /emailTemplates/{eventType} {
        allow read: if canViewEmailTemplates(hotelId);
        allow write: if canManageEmailTemplates(hotelId);
      }

      // Email Customization: Per-Hotel Email Settings (Hotel Admin / Admin / RBAC-assigned own hotel)
      match /emailSettings/{docId} {
        allow read: if canViewEmailTemplates(hotelId);
        allow write: if canManageEmailTemplates(hotelId);
      }

      // Email Customization: Per-Hotel Email Image Library Metadata (Hotel Admin / Admin / RBAC-assigned own hotel)
      match /emailImages/{imageId} {
        allow read: if canViewEmailTemplates(hotelId);
        allow write: if canManageEmailTemplates(hotelId);
      }

      // Daily Hotel Operations Report: Per-Hotel Configuration & Recipients (strict tenant isolation)
      match /dailyOpsReportConfig/{docId} {
        allow read: if canViewEmailTemplates(hotelId);
        allow create, update: if canManageEmailTemplates(hotelId) &&
                                 request.resource.data.hotelId == hotelId &&
                                 request.resource.data.enabled is bool &&
                                 request.resource.data.scheduledTime is string &&
                                 request.resource.data.timezone is string &&
                                 request.resource.data.recipients is list &&
                                 request.resource.data.recipients.size() <= 50;
        allow delete: if isSuperAdmin();
      }

      // Daily Hotel Operations Report: Per-Hotel Execution & Delivery History (strict tenant isolation)
      match /dailyOpsReportRuns/{runId} {
        allow read: if canViewEmailTemplates(hotelId);
        allow create, update: if canManageEmailTemplates(hotelId) &&
                                 request.resource.data.hotelId == hotelId &&
                                 request.resource.data.reportDate is string &&
                                 request.resource.data.generationStatus in ['generated', 'failed'] &&
                                 request.resource.data.deliveryStatus in ['pending', 'sent', 'partial', 'failed'];
        allow delete: if isSuperAdmin();
      }

      // User Settings & Preferences
      match /user_settings/{userId} {
        allow read, write: if isSuperAdmin() || (sameHotel(hotelId) && (request.auth.uid == userId || isHotelAdmin() || hasStaffManagementPermission()));
        allow delete: if isSuperAdmin() || (sameHotel(hotelId) && (request.auth.uid == userId || isHotelAdmin() || hasStaffManagementPermission()));
      }

      // Ledger entries are immutable audit records, but voidable/deletable by hotel admins and superadmins
      match /ledger/{entryId} {
        allow read: if isSuperAdmin() || 
                       isStaffOf(hotelId) || 
                       sameHotel(hotelId) || 
                       isAuthenticated() ||
                       (resource != null && resource.data.hotelId == hotelId);
        allow create: if isSuperAdmin() || (
          (isStaffOf(hotelId) || sameHotel(hotelId) || (isAuthenticated() && request.resource.data.hotelId == hotelId)) &&
          request.resource.data.amount != null &&
          request.resource.data.amount >= 0 &&
          request.resource.data.type in ['debit', 'credit'] &&
          request.resource.data.category is string &&
          request.resource.data.timestamp != null &&
          (
            !(request.resource.data.type == 'debit' &&
              request.resource.data.category in ['F & B', 'restaurant', 'F&B', 'food', 'bar', 'room_service'] &&
              request.resource.data.get('reservationId', null) != null) ||
            isRoomRestaurantPostingAllowedForReservation(hotelId, request.resource.data.get('reservationId', ''))
          )
        );
        allow update: if isSuperAdmin() || (sameHotel(hotelId) && (isHotelAdmin() || isAdmin())) || isAuthenticated();
        allow delete: if isSuperAdmin() || (sameHotel(hotelId) && (isHotelAdmin() || isAdmin() || isStaffOf(hotelId))) || isAuthenticated();
      }

      // Outstanding Debt Ledger (AR) and guest balances
      match /outstanding_debt_ledger/{debtId} {
        allow read: if isSuperAdmin() || isStaffOf(hotelId) || sameHotel(hotelId) || isAuthenticated();
        allow create, update: if isSuperAdmin() || isStaffOf(hotelId) || sameHotel(hotelId) || isAuthenticated();
        allow delete: if isSuperAdmin() || (sameHotel(hotelId) && (isHotelAdmin() || isAdmin() || isStaffOf(hotelId))) || isAuthenticated();
      }

      // Financial transaction records & summaries
      match /finance/{docId} {
        allow read: if isSuperAdmin() || isStaffOf(hotelId) || sameHotel(hotelId) || isAuthenticated();
        allow create, update: if isSuperAdmin() || isStaffOf(hotelId) || sameHotel(hotelId) || isAuthenticated();
        allow delete: if isSuperAdmin() || (sameHotel(hotelId) && (isHotelAdmin() || isAdmin() || isStaffOf(hotelId))) || isAuthenticated();
      }

      // Staff account activation and password reset tokens for this property
      match /passwordResetTokens/{tokenId} {
        allow read: if true;
        allow create: if isSuperAdmin() || isHotelAdmin() || hasStaffManagementPermission() || isAuthenticated();
        allow update: if isSuperAdmin() || isHotelAdmin() || hasStaffManagementPermission() ||
                         (request.resource.data.isUsed == true && resource.data.isUsed == false) ||
                         (request.resource.data.status in ['used', 'revoked', 'expired']);
        allow delete: if isSuperAdmin() || (sameHotel(hotelId) && (isHotelAdmin() || hasStaffManagementPermission()));
      }

      // Promotional campaigns and discount codes
      match /promotions/{promoId} {
        allow read: if isSuperAdmin() || isStaffOf(hotelId) || sameHotel(hotelId);
        allow create, delete: if isSuperAdmin() || (sameHotel(hotelId) && (isHotelAdmin() || isAdmin()));
        allow update: if isSuperAdmin() || 
                         (sameHotel(hotelId) && (isHotelAdmin() || isAdmin())) ||
                         (sameHotel(hotelId) && isStaffOf(hotelId) && 
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount', 'redemptions', 'updatedAt', 'updatedBy']));
      }

      // Food & Beverage Kitchen Orders (Full live sync, creation, status update, settlement, and deletion)
      match /kitchen_orders/{orderId} {
        allow read, delete: if true;
        allow create: if (
          !(request.resource.data.get('roomChargedAmount', 0) > 0 || request.resource.data.get('financialStatus', '') == 'posted_to_room') ||
          isRoomRestaurantPostingAllowedForReservation(hotelId, request.resource.data.get('reservationId', ''))
        );
        allow update: if (
          !(
            request.resource.data.get('roomChargedAmount', 0) > resource.data.get('roomChargedAmount', 0) ||
            (request.resource.data.get('financialStatus', '') == 'posted_to_room' && resource.data.get('financialStatus', '') != 'posted_to_room')
          ) ||
          isRoomRestaurantPostingAllowedForReservation(hotelId, request.resource.data.get('reservationId', ''))
        );
      }

      // Rooms: Protect restaurant posting restriction fields with block_restaurant_posting RBAC
      match /rooms/{roomId} {
        allow read: if isSuperAdmin() || isStaffOf(hotelId) || sameHotel(hotelId) ||
                       isAuthenticated() ||
                       (resource != null && resource.data.hotelId == hotelId);
        allow create: if (
          isSuperAdmin() || isStaffOf(hotelId) || sameHotel(hotelId) ||
          isAuthenticated() ||
          (exists(/databases/$(database)/documents/hotels/$(hotelId)) &&
           get(/databases/$(database)/documents/hotels/$(hotelId)).data.adminUIDs != null &&
           get(/databases/$(database)/documents/hotels/$(hotelId)).data.adminUIDs is list &&
           get(/databases/$(database)/documents/hotels/$(hotelId)).data.adminUIDs.hasAny([request.auth.uid]))
        ) && (
          !(request.resource.data.get('restaurantPostingBlocked', false) == true) ||
          canBlockRestaurantPosting(hotelId)
        );
        allow update: if (
          isSuperAdmin() || isStaffOf(hotelId) || sameHotel(hotelId) ||
          isAuthenticated() ||
          (exists(/databases/$(database)/documents/hotels/$(hotelId)) &&
           get(/databases/$(database)/documents/hotels/$(hotelId)).data.adminUIDs != null &&
           get(/databases/$(database)/documents/hotels/$(hotelId)).data.adminUIDs is list &&
           get(/databases/$(database)/documents/hotels/$(hotelId)).data.adminUIDs.hasAny([request.auth.uid]))
        ) && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'restaurantPostingBlocked',
            'restaurantPostingRestriction',
            'restaurantPostingHistory'
          ]) ||
          canBlockRestaurantPosting(hotelId)
        );
        allow delete: if isSuperAdmin() || (sameHotel(hotelId) && (isHotelAdmin() || isAdmin() || isStaffOf(hotelId))) || isAuthenticated();
      }

      // Rate Configurations (Room Pricing & Seasonal Rates)
      match /rate_configurations/{configId} {
        allow read: if isSuperAdmin() || isStaffOf(hotelId) || sameHotel(hotelId) ||
                       isAuthenticated() ||
                       (resource != null && resource.data.hotelId == hotelId);
        allow create, update: if isSuperAdmin() ||
                                 (sameHotel(hotelId) && (isHotelAdmin() || isAdmin() || isStaffOf(hotelId))) ||
                                 isAuthenticated() ||
                                 (exists(/databases/$(database)/documents/hotels/$(hotelId)) &&
                                  get(/databases/$(database)/documents/hotels/$(hotelId)).data.adminUIDs != null &&
                                  get(/databases/$(database)/documents/hotels/$(hotelId)).data.adminUIDs is list &&
                                  get(/databases/$(database)/documents/hotels/$(hotelId)).data.adminUIDs.hasAny([request.auth.uid]));
        allow delete: if isSuperAdmin() || (sameHotel(hotelId) && (isHotelAdmin() || isAdmin() || isStaffOf(hotelId))) || isAuthenticated();
      }

      // Guest Account Deposit Transactions: Enforce deposit_guest_account RBAC on creating new deposit entries
      match /guest_deposit_transactions/{txId} {
        allow read: if isSuperAdmin() || isStaffOf(hotelId) || sameHotel(hotelId) ||
                       isAuthenticated() ||
                       (resource != null && resource.data.hotelId == hotelId);
        allow create: if (
          isSuperAdmin() || isStaffOf(hotelId) || sameHotel(hotelId) ||
          isAuthenticated() ||
          (exists(/databases/$(database)/documents/hotels/$(hotelId)) &&
           get(/databases/$(database)/documents/hotels/$(hotelId)).data.adminUIDs != null &&
           get(/databases/$(database)/documents/hotels/$(hotelId)).data.adminUIDs is list &&
           get(/databases/$(database)/documents/hotels/$(hotelId)).data.adminUIDs.hasAny([request.auth.uid]))
        ) && (
          request.resource.data.get('type', '') != 'deposit' ||
          canDepositGuestAccount(hotelId)
        );
        allow update: if isSuperAdmin() || isStaffOf(hotelId) || sameHotel(hotelId) ||
                         isAuthenticated() ||
                         (exists(/databases/$(database)/documents/hotels/$(hotelId)) &&
                          get(/databases/$(database)/documents/hotels/$(hotelId)).data.adminUIDs != null &&
                          get(/databases/$(database)/documents/hotels/$(hotelId)).data.adminUIDs is list &&
                          get(/databases/$(database)/documents/hotels/$(hotelId)).data.adminUIDs.hasAny([request.auth.uid]));
        allow delete: if isSuperAdmin() || (sameHotel(hotelId) && (isHotelAdmin() || isAdmin() || isStaffOf(hotelId))) || isAuthenticated();
      }

      // Guest Loyalty Accounts (Strict multi-tenant isolation & admin-only write control)
      match /loyaltyAccounts/{guestId} {
        allow get: if isValidLoyaltyId(guestId) && canViewLoyalty(hotelId);
        allow list: if canViewLoyalty(hotelId);
        allow create, update: if isValidLoyaltyId(guestId) &&
                                 canManageLoyalty(hotelId) &&
                                 isValidLoyaltyAccount(request.resource.data, hotelId, guestId);
        allow delete: if isStrictHotelAdminOf(hotelId);
      }

      // Guest Loyalty Transactions (Append-only ledger — no edits; deletion restricted to Hotel Admin / SuperAdmin for Complete System Reset)
      match /loyaltyTransactions/{txId} {
        allow get: if isValidLoyaltyId(txId) && canViewLoyalty(hotelId);
        allow list: if canViewLoyalty(hotelId);
        allow create: if isValidLoyaltyId(txId) &&
                         canManageLoyalty(hotelId) &&
                         isValidLoyaltyTransaction(request.resource.data, hotelId);
        allow update: if false;
        allow delete: if isStrictHotelAdminOf(hotelId);
      }

      // Recursive subcollections (Reservations, Housekeeping, Staff, etc. — excludes hardened loyalty & daily ops collections)
      match /{subcol}/{docPath=**} {
        allow read: if !(subcol in ['loyaltyAccounts', 'loyaltyTransactions', 'dailyOpsReportConfig', 'dailyOpsReportRuns']) && (
                       isSuperAdmin() || isStaffOf(hotelId) || sameHotel(hotelId) ||
                       isAuthenticated() ||
                       (resource != null && resource.data.hotelId == hotelId)
                     );
        allow create, update: if !(subcol in ['loyaltyAccounts', 'loyaltyTransactions', 'dailyOpsReportConfig', 'dailyOpsReportRuns']) && (
                                 isSuperAdmin() || isStaffOf(hotelId) || sameHotel(hotelId) ||
                                 isAuthenticated() ||
                                 (exists(/databases/$(database)/documents/hotels/$(hotelId)) &&
                                  get(/databases/$(database)/documents/hotels/$(hotelId)).data.adminUIDs != null &&
                                  get(/databases/$(database)/documents/hotels/$(hotelId)).data.adminUIDs is list &&
                                  get(/databases/$(database)/documents/hotels/$(hotelId)).data.adminUIDs.hasAny([request.auth.uid]))
                               );
        allow delete: if !(subcol in ['loyaltyAccounts', 'loyaltyTransactions', 'dailyOpsReportConfig', 'dailyOpsReportRuns']) && (
                         isSuperAdmin() || (sameHotel(hotelId) && (isHotelAdmin() || isAdmin() || isStaffOf(hotelId))) || isAuthenticated()
                       );
      }
    }

    //////////////////////////////
    // SYSTEM SETTINGS & LOGS
    //////////////////////////////

    match /system/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /systemLogs/{allPaths=**} {
      allow read: if isSuperAdmin();
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    match /activityLogs/{logId} {
      allow read, list: if isSuperAdmin() || isAuthenticated();
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    // Collection Group rule for activityLogs
    match /{path=**}/activityLogs/{logId} {
      allow read, list: if isSuperAdmin() || isAuthenticated();
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    // Collection Group rule for kitchen_orders
    match /{path=**}/kitchen_orders/{orderId} {
      allow read, write: if true;
    }

    match /auditLogs/{logId} {
      allow read, list: if isSuperAdmin() || isAuthenticated();
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    match /{path=**}/auditLogs/{logId} {
      allow read, list: if isSuperAdmin() || isAuthenticated();
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    match /{path=**}/AuditLogs/{logId} {
      allow read, list: if isSuperAdmin() || isAuthenticated();
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    match /AuditLogs/{logId} {
      allow read, list: if isSuperAdmin() || isAuthenticated();
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    match /GlobalAuditLog/{logId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && isAdmin() && (resource == null || resource.data.hotelId == getHotelId()));
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    match /registration/{docId} {
      allow create, read: if true;
      allow write: if isSuperAdmin();
    }

    match /trackingCodeRequests/{requestId} {
      // SuperAdmin has full management access to review, approve, and reject
      allow read, write: if isSuperAdmin();
      // Prospective hotel owners can submit code requests before registering, and check request status
      allow read, create: if true;
      allow update, delete: if isSuperAdmin();
    }

    match /passwordResetTokens/{tokenId} {
      allow read, write: if true;
    }

    match /activationTokens/{tokenId} {
      allow read, write: if true;
    }

    match /user_settings/{userId} {
      allow read, write, delete: if isSuperAdmin() || (isAuthenticated() && (request.auth.uid == userId || isHotelAdmin() || hasStaffManagementPermission()));
    }

    match /subscriptions/{hotelId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && sameHotel(hotelId));
      allow write: if isSuperAdmin();
    }
  }
}
